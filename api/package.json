{
  "name": "@support-desk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare:embeddings": "node --import tsx scripts/prepare-embeddings.ts",
    "snapshot:embeddings": "node --import tsx scripts/save-embeddings.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "pg-mem": "^3.0.0",
    "typescript": "^5.9.0"
  }
}
